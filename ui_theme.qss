QMainWindow, QWidget#appRoot { background: #0b1026; color: #f7f7f6; }
QWidget { color: #f7f7f6; font-family: "Be Vietnam Pro"; font-size: 12px; }
QWidget#header, QFrame#header { background: #0b1026; border-bottom: 1px solid #35446a; }
QFrame#footer, QWidget#sidebar { background: #101831; border-top: 1px solid #35446a; }
QFrame#card { background: transparent; border: none; }
QDialog#videoEditor { background: #0b1026; }
QLabel { background: transparent; border: none; color: #d9dfff; }
QLabel[role="brand"] { color: #f7f7f6; font-size: 18px; font-weight: 700; }
QLabel[role="title"] { color: #f7f7f6; font-size: 22px; font-weight: 700; }
QLabel[role="section"] { color: #f7f7f6; font-size: 14px; font-weight: 600; }
QLabel[role="strong"] { color: #f7f7f6; font-weight: 600; }
QLabel[role="micro"] { color: #c1cbff; font-family: "JetBrains Mono"; font-size: 10px; }
QLabel[role="guidance"] { padding: 8px 24px; color: #c1cbff; }
QLabel[role="status"] { background: #101831; border-top: 1px solid #35446a; padding: 8px 24px; color: #9be6c5; font-size: 10px; }
QLabel[role="error"] { color: #ffd0e5; }
QLabel#thumbnail { background: #0b1026; border: 1px solid #35446a; border-radius: 12px; color: #c1cbff; }
QPushButton { background: #202b52; color: #f7f7f6; border: 1px solid #35446a; border-radius: 8px; padding: 8px 12px; font-weight: 500; }
QPushButton:hover { background: #29365f; }
QPushButton:focus { border-color: #c1cbff; }
QPushButton:disabled { background: #151d39; color: #7d86a3; border-color: #283352; }
QPushButton[kind="primary"] { background: #fad84c; color: #131313; border: 1px solid #fad84c; font-weight: 600; }
QPushButton[kind="primary"]:hover { background: #ffe578; }
QPushButton[kind="primary"]:disabled { background: #6d6034; color: #c2b479; border-color: #6d6034; }
QPushButton[kind="danger"] { background: transparent; color: #ffd0e5; border-color: transparent; }
QPushButton[kind="danger"]:hover { background: #392b48; }
QPushButton[kind="step"] { background: transparent; border-color: transparent; color: #c1cbff; padding: 8px 12px; }
QPushButton[kind="step"]:checked { background: #172044; color: #f7f7f6; border-bottom: 2px solid #fad84c; }
QPushButton[kind="disclosure"] { background: transparent; text-align: left; color: #c1cbff; border: none; padding: 8px 0; }
QPushButton[kind="disclosure"]:hover { color: #f7f7f6; }
QLineEdit, QSpinBox, QComboBox { background: #101831; color: #f7f7f6; border: 1px solid #455680; border-radius: 8px; padding: 8px; min-height: 18px; selection-background-color: #35446a; }
QLineEdit { font-family: "JetBrains Mono"; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #c1cbff; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled { color: #7d86a3; background: #151d39; }
QComboBox::drop-down { width: 24px; border: none; }
QComboBox QAbstractItemView { background: #172044; color: #f7f7f6; selection-background-color: #29365f; selection-color: #f7f7f6; }
QSpinBox::up-button, QSpinBox::down-button { width: 18px; border: none; }
QCheckBox { spacing: 10px; background: transparent; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #455680; border-radius: 4px; background: #202b52; }
QCheckBox::indicator:checked { background: #fad84c; border-color: #fad84c; image: url("@ASSETS@/check.svg"); }
QCheckBox::indicator:disabled { background: #35405a; }
QCheckBox[kind="format"] { background: #202b52; border: 1px solid #35446a; border-radius: 12px; padding: 0 14px; }
QCheckBox[kind="format"]:checked { background: #29365f; border-color: #c1cbff; }
QListWidget, QTableWidget, QTextEdit { background: #101831; alternate-background-color: #172044; border: 1px solid #35446a; border-radius: 8px; padding: 6px; selection-background-color: #29365f; selection-color: #f7f7f6; gridline-color: #35446a; }
QListWidget::item { padding: 12px 8px; border-bottom: 1px solid #283352; }
QListWidget::item:selected { background: #29365f; border: 1px solid #c1cbff; border-radius: 6px; }
QTableWidget::item { padding: 8px; }
QHeaderView::section { background: #172044; color: #d9dfff; padding: 12px 8px; border: none; border-bottom: 1px solid #35446a; }
QTextEdit#namePreview, QTextEdit#log { font-family: "JetBrains Mono"; font-size: 11px; }
QTextEdit#log { color: #9be6c5; }
QProgressBar { background: #101831; border: 1px solid #35446a; border-radius: 6px; min-height: 20px; text-align: center; }
QProgressBar::chunk { background: #fad84c; border-radius: 5px; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: #0b1026; }
QScrollBar:vertical { background: #101831; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #35446a; border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { background: #29365f; color: #f7f7f6; border: 1px solid #455680; padding: 6px; }
QComboBox::down-arrow { image: url("@ASSETS@/chevron.svg"); width: 12px; height: 12px; }

QMenu { background: #172044; color: #f7f7f6; border: 1px solid #35446a; padding: 6px; }
QMenu::item { padding: 9px 16px; }
QMenu::item:selected { background: #29365f; }
QMenu::item:disabled { color: #7d86a3; }
